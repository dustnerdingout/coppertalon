# Copper Talon Detailing Co.
# Clean URLs and permanent (301) redirects for old addresses.
RewriteEngine On

# /index.html and /folder/index.html -> / and /folder/
RewriteCond %{THE_REQUEST} \s/+((?:[^/?\s]+/)*)index\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Old .html pages -> clean folder URLs (any ?query is kept)
RewriteRule ^pricing\.html$ /pricing/ [R=301,L]
RewriteRule ^care-plans\.html$ /care-plans/ [R=301,L]
RewriteRule ^about\.html$ /about/ [R=301,L]
RewriteRule ^contact\.html$ /contact/ [R=301,L]
RewriteRule ^book\.html$ /book/ [R=301,L]

# Packages now live on the Detail Menu page (keeps any ?query before #packages)
RewriteCond %{QUERY_STRING} ^(.+)$
RewriteRule ^packages\.html$ /pricing/?%1#packages [R=301,NE,L]
RewriteRule ^packages\.html$ /pricing/#packages [R=301,NE,L]

# Memberships were renamed to Care Plans
RewriteRule ^memberships\.html$ /care-plans/ [R=301,L]

# Browser caching: images and fonts for a year, CSS and JS for a year
# (their links carry ?v= so a new version is picked up right away),
# pages always checked for the latest copy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|ico|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>
